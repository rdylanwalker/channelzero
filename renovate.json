{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group non-major updates by manager to reduce PR noise",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies ({{manager}})",
      "groupSlug": "{{manager}}-non-major"
    },
    {
      "description": "Keep Playwright npm package and container image aligned",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "playwright"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
