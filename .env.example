# Server & Container
PORT=8080
TZ=America/New_York
PUID=1000
PGID=1000
DATA_DIR=/data
CONFIG_FILE=/config/config.json

# Dashboard Behavior
REGION=US
NEW_RELEASE_DAYS=30
REFRESH_INTERVAL_HOURS=6
# Comma-separated priority order of providers
PROVIDERS=netflix,max,disney_plus,prime_video,hulu,apple_tv_plus,peacock,paramount_plus

# Metadata Sources (Priority: Anonymous -> Free Key -> Paid/Optional)
# 1. TVmaze (Anonymous, no API key required — enabled by default)
TVMAZE_ENABLED=true

# 2. TMDB (Free API key: https://www.themoviedb.org/settings/api)
# Enables movies + TV + regional streaming provider availability
TMDB_ENABLED=false
TMDB_API_KEY=
# Or use a mounted secret file:
# TMDB_API_KEY_FILE=/run/secrets/tmdb_api_key

# 3. OMDb (Free-tier API key: https://www.omdbapi.com/apikey.aspx)
# Enriches titles with IMDb, Rotten Tomatoes, and Metacritic ratings
OMDB_ENABLED=false
OMDB_API_KEY=
# OMDB_API_KEY_FILE=/run/secrets/omdb_api_key

# 4. Watchmode (Optional free/paid-tier API key: https://api.watchmode.com/)
# Enriches titles with direct streaming deep links
WATCHMODE_ENABLED=false
WATCHMODE_API_KEY=
# WATCHMODE_API_KEY_FILE=/run/secrets/watchmode_api_key
